# ScholarGraph Environment Configuration
# Copy this file to .env and fill in real values before running.

# ===== Auth / Backend =====
SECRET_KEY=change-this-to-a-random-32-char-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Public URLs used to build verification/reset links
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:8501

# Database
# Local development: relative path (./research_agent.db)
# Docker deployment: absolute path on the writable app_data volume
#   sqlite+aiosqlite:////app/data/research_agent.db
# Production (Neon Postgres):
#   postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./research_agent.db
REDIS_URL=redis://localhost:6379/0

# Third-Party Integrations
GROQ_API_KEY=your-groq-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here

# Mail service
MAIL_USERNAME=your-mail-username@gmail.com
MAIL_PASSWORD=your-mail-app-password-here
MAIL_FROM=your-email@gmail.com
MAIL_FROM_NAME=ScholarGraph
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False

# Security & Limits
TOKEN_BLOCKLIST_STRICT=true
CORS_ORIGINS=*
ALLOWED_HOSTS=*

# Defaults
DEFAULT_MODEL=gemini-2.5-flash
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-3.8-flash,gemini-3.5-flash-lite,gemini-2.5-pro
FALLBACK_GROQ_MODEL=llama-3.1-8b-instant

# Storage
UPLOAD_DIR=uploads
CHROMA_DIR=chroma_db
CHROMA_HOST=
CHROMA_PORT=8000
SEMANTIC_SCHOLAR_API_KEY=

# Rate limits
MAX_MESSAGE_CHARS=4000
MAX_UPLOAD_MB=20
MAX_DOCS_PER_THREAD=4
CHAT_RATE_LIMIT_PER_MIN=20
UPLOAD_RATE_LIMIT_PER_HOUR=4
GRAPH_RECURSION_LIMIT=16
MAX_CONTEXT_TOKENS=8000
MAX_TOOL_CALLS_PER_TURN=2
TURN_TIMEOUT_SECONDS=180
SAVE_PAPER_RATE_LIMIT_PER_HOUR=30
PAPER_SEARCH_RATE_LIMIT_PER_MIN=5

# LangSmith (tracing)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=ScholarGraph
LANGSMITH_AGENT_ENVIRONMENT=local